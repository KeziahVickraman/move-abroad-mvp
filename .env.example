# ===================================================================
# MoveAbroad SG (v1.1) — Environment Variables Specification
# ===================================================================

# 1. Google AI Studio Runtime (Auto-injected)
GEMINI_API_KEY=""
APP_URL=""

# 2. Supabase Postgres & Auth (v1 Base)
# Find at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 3. Singapore Land Transport Authority (LTA DataMall)
# For: Real-time Bus Arrivals, MRT Service Disruptions, Carpark Lot Counts
# Free registration: https://datamall.lta.gov.sg/content/datamall/en/request-api.html
# Header used: AccountKey: <your_key>
LTA_DATAMALL_API_KEY=""

# 4. Eventbrite API (Singapore Events & Mixers)
# For: Live discovery of tech, networking, and cultural events in SG
# Get token at: https://www.eventbrite.com/platform/api
# Header used: Authorization: Bearer <your_token>
EVENTBRITE_OAUTH_TOKEN=""

# 5. Meetup.com API (Singapore Community Groups)
# For: Real-time community meetups near geo center (1.3521, 103.8198)
# Get key at: https://www.meetup.com/api/
MEETUP_API_KEY=""

# 6. Ticketmaster Discovery API (Singapore Concerts & Shows)
# For: Large-scale gigs at Singapore Indoor Stadium, National Stadium, Esplanade
# Free API key at: https://developer.ticketmaster.com/products-and-docs/apis/discovery-api/v2/
TICKETMASTER_API_KEY=""

# 7. OneMap SG API (Singapore Land Authority - SLA) [Default Free Map Provider]
# For: Official Singapore planning zones, building search, route navigation
# Free registration: https://www.onemap.gov.sg/docs/
ONEMAP_API_TOKEN=""

# 8. Google Places & Maps API [Optional Paid Fallback - Requires Approval]
# Only if OneMap coverage is insufficient. Guardrail: watch usage & billing
# Get key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=""

# 9. ExchangeRate-API / Open Exchange Rates (Real-Time Currency Ticker)
# For: Live SGD conversion rates against USD, EUR, GBP, AUD, INR, MYR, CNY, JPY
# Free API key at: https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=""

# 10. Telegram Bot API (Automated Event Reminders & Group Invites)
# For: Direct bot notifications replacing manual copy-pasting
# Create bot via @BotFather on Telegram: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=""
